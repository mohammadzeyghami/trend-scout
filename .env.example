# Postgres (compose.yml exposes it on 5438)
DATABASE_URL=postgresql://trend:trend@localhost:5438/trend_scout

# OpenRouter — the agents' model transport
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MAX_IN_FLIGHT=2       # parallel model calls; raise when the account has plenty of credit

# Platform providers. Each is "mock" (deterministic fake posts, no key needed) or the real adapter.
PROVIDER_YOUTUBE=mock        # mock | youtube   (needs YOUTUBE_API_KEY — Data API v3)
PROVIDER_INSTAGRAM=mock      # mock | apify     (needs APIFY_TOKEN)
PROVIDER_TIKTOK=mock         # mock | apify     (needs APIFY_TOKEN)
YOUTUBE_API_KEY=
APIFY_TOKEN=
# Apify actors (override only if you use different ones)
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper

# Collector budget
MAX_POSTS_PER_PLATFORM=30
